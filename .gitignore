# Dependencies
# Installed packages and package-manager state are recreated from the lockfile.
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test output
# Reports, traces and saved browser sessions can contain account data.
**/coverage
**/playwright-report
**/test-results
/.playwright-cli
**/playwright/.auth/

# Next.js output
# The MapLibre worker is copied from node_modules before development and builds.
**/.next/
/out/
/apps/web/public/maplibre/

# Local machine files and compiler caches
.DS_Store
*.pem
*.tsbuildinfo
.eslintcache

# Editor and agent session state
# Shared instructions live in the tracked .agents directory.
/.claude/
/.codex/
/.cursor/

# Package-manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
# Track the empty setup template, but keep every populated environment local.
.env*
!.env.example

# Vercel project-link state
.vercel

# Supabase CLI state
# Configuration, migrations and seeds remain tracked under supabase/.
/.supabase/
/supabase/.temp/

# Rebuildable import, build and task caches
/.catalogue-cache/
**/.turbo/
**/dist/

/apps/web/.catalogue-cache/
