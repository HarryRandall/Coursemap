{
  "name": "@coursemap/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "node scripts/local/dev-preview.mjs",
    "dev:prod": "node scripts/copy-maplibre-worker.mjs && next dev --webpack",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "node scripts/local/build-preview.mjs",
    "build:next": "next build --webpack",
    "build:prod": "node scripts/copy-maplibre-worker.mjs && next build --webpack",
    "start": "node scripts/local/start-preview.mjs",
    "start:prod": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit --incremental false",
    "test:unit": "vitest run --project unit --project component",
    "test:catalogue-db": "vitest run --project database",
    "test:build:auth": "NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4318 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:9 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_test pnpm build:prod",
    "test:auth-access": "COURSEMAP_TEST_PROFILE=access playwright test",
    "test:e2e:build": "node scripts/local/build-e2e.mjs",
    "test:e2e": "COURSEMAP_TEST_PROFILE=authenticated playwright test",
    "calendar:fetch": "node scripts/catalogue/fetch-anu-calendar.mjs",
    "calendar:import": "node scripts/catalogue/import-calendar.mjs",
    "course-import:benchmark": "node --env-file-if-exists=.env.local scripts/catalogue/benchmark-course-models.mjs",
    "rooms:buildings:fetch": "node scripts/rooms/sync-anu-buildings.mjs fetch",
    "rooms:buildings:generate": "node scripts/rooms/sync-anu-buildings.mjs generate"
  },
  "dependencies": {
    "@coursemap/ui": "workspace:*",
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:",
    "@vercel/queue": "catalog:",
    "@xyflow/react": "catalog:",
    "cheerio": "catalog:",
    "clsx": "catalog:",
    "cmdk": "catalog:",
    "domhandler": "catalog:",
    "geist": "catalog:",
    "highlight.js": "catalog:",
    "lucide-react": "catalog:",
    "maplibre-gl": "catalog:",
    "motion": "catalog:",
    "next": "catalog:",
    "next-themes": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/geojson": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "eslint-config-prettier": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
